# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin emails separated by commas. Users whose email is listed can access /admin.
ADMIN_EMAILS="mrs@qq.com,b@qq.com"

# Required for QQ assistant credential encryption and local worker authentication.
# Use one random string of at least 32 characters and keep it stable after deployment.
QQ_ASSISTANT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional; defaults to the local Next server on PORT.
QQ_ASSISTANT_INTERNAL_URL=""
