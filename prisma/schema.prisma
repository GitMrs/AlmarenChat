generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  avatar       String?
  apiBaseUrl   String?
  apiKey       String?
  modelName    String?
  customModelEnabled Boolean @default(false)
  tavilyApiKey String?
  defaultStyle String?
  contextMessageLimit Int @default(40)
  dailyChatLimit Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  conversations Conversation[]
  agents        Agent[]
  spaces        Space[]
  favorites     FavoriteAgent[]
  chatUsages    DailyChatUsage[]
  agentRuns     AgentRun[]
}

model Agent {
  id           String         @id @default(uuid())
  creatorId    String?
  creator      User?          @relation(fields: [creatorId], references: [id])
  name         String
  avatar       String?
  description  String?
  category     String?
  tone         String?
  greeting     String?
  systemPrompt String?
  model        String?
  isPublic     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  knowledgeDocuments KnowledgeDocument[]
}

model Space {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  instructions String?
  hostAgentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  SpaceMember[]
  messages SpaceMessage[]
  files    SpaceFile[]
  runs     AgentRun[]

  @@index([userId, updatedAt])
}

model SpaceMember {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agentId   String
  roleName  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([spaceId, agentId])
  @@index([spaceId, sortOrder])
  @@index([agentId])
}

model SpaceMessage {
  id             String   @id @default(uuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role           String   // "user" | "assistant" | "system"
  speakerAgentId String?
  content        String
  attachments    Json?
  createdAt      DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([speakerAgentId])
}

model SpaceFile {
  id           String   @id @default(uuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String?
  size         Int?
  relativePath String
  runId        String?
  taskId       String?
  status       String   @default("READY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt

  @@index([spaceId])
  @@index([runId])
  @@index([taskId])
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([agentId])
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agentId    String
  chunkIndex Int
  content    String
  embedding  Json
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([documentId])
}

model Conversation {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  agentId             String?
  agentName           String?
  agentAvatar         String?
  agentCategory       String?
  agentTone           String?
  agentDescription    String?
  agentSystemPrompt   String?
  contextMessageLimit Int?
  title               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // "user" | "assistant" | "system"
  content        String
  attachments    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model FavoriteAgent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agentId   String
  source    String   @default("custom")
  createdAt DateTime @default(now())

  @@unique([userId, source, agentId])
}

model DailyChatUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       String
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model AgentRun {
  id          String    @id @default(uuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  input       String
  status      String    @default("QUEUED")
  result      String?
  error       String?
  retryOfId   String?
  attempt     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  tasks  AgentTask[]
  events AgentRunEvent[]

  @@index([spaceId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AgentTask {
  id          String    @id @default(uuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentId     String
  agentName   String
  title       String
  instruction String
  status      String    @default("PENDING")
  result      String?
  error       String?
  reviewFeedback String?
  attempt     Int       @default(1)
  sortOrder   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?

  @@index([runId, sortOrder])
  @@index([status])
}

model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}
