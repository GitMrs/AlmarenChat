generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  avatar       String?
  apiBaseUrl   String?
  apiKey       String?
  modelName    String?
  customModelEnabled Boolean @default(false)
  tavilyApiKey String?
  defaultStyle String?
  contextMessageLimit Int @default(40)
  dailyChatLimit Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  conversations Conversation[]
  agents        Agent[]
  spaces        Space[]
  favorites     FavoriteAgent[]
  chatUsages    DailyChatUsage[]
  agentRuns     AgentRun[]
  discussions   SpaceDiscussion[]
}

model Agent {
  id           String         @id @default(uuid())
  creatorId    String?
  creator      User?          @relation(fields: [creatorId], references: [id])
  name         String
  avatar       String?
  description  String?
  category     String?
  tone         String?
  greeting     String?
  systemPrompt String?
  model        String?
  isPublic     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  knowledgeDocuments KnowledgeDocument[]
}

model Space {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  instructions String?
  executionMode String @default("REVIEW_DISPATCH")
  hostAgentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  SpaceMember[]
  messages SpaceMessage[]
  files    SpaceFile[]
  runs     AgentRun[]
  discussions SpaceDiscussion[]
  memory      SpaceMemory?

  @@index([userId, updatedAt])
}

model SpaceMember {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agentId   String
  roleName  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([spaceId, agentId])
  @@index([spaceId, sortOrder])
  @@index([agentId])
}

model AgentSession {
  id            String   @id @default(uuid())
  spaceId       String
  agentId       String
  status        String   @default("IDLE")
  currentTaskId String?
  worklog       String?
  summary       String?
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, agentId])
  @@index([spaceId, status])
  @@index([currentTaskId])
}

model SpaceMessage {
  id             String   @id @default(uuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role           String   // "user" | "assistant" | "system"
  speakerAgentId String?
  content        String
  attachments    Json?
  sourceKey      String?  @unique
  createdAt      DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([speakerAgentId])
}

model SpaceFile {
  id           String   @id @default(uuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String?
  size         Int?
  relativePath String
  runId        String?
  taskId       String?
  status       String   @default("READY")
  shareId      String?  @unique
  shareEnabled Boolean  @default(false)
  sharedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt

  @@index([spaceId])
  @@index([runId])
  @@index([taskId])
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([agentId])
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agentId    String
  chunkIndex Int
  content    String
  embedding  Json
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([documentId])
}

model Conversation {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  agentId             String?
  agentName           String?
  agentAvatar         String?
  agentCategory       String?
  agentTone           String?
  agentDescription    String?
  agentSystemPrompt   String?
  contextMessageLimit Int?
  title               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // "user" | "assistant" | "system"
  content        String
  attachments    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model FavoriteAgent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agentId   String
  source    String   @default("custom")
  createdAt DateTime @default(now())

  @@unique([userId, source, agentId])
}

model DailyChatUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       String
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model SpaceMemory {
  spaceId         String   @id
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  recentActivity  Json
  rollingSummary  String?
  historySummary  String?
  activityCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SpaceDiscussion {
  id                String    @id @default(uuid())
  spaceId           String
  space             Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic             String
  participantIds    Json
  transcript        Json?
  status            String    @default("QUEUED")
  currentRound      Int       @default(1)
  currentIndex      Int       @default(0)
  maxRounds         Int       @default(2)
  allowWeb          Boolean   @default(false)
  webSearchCount    Int       @default(0)
  pendingResearch   Json?
  researchContext   String?
  result            String?
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  @@index([spaceId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AgentRun {
  id          String    @id @default(uuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  input       String
  status      String    @default("QUEUED")
  result      String?
  error       String?
  retryOfId   String?
  attempt     Int       @default(1)
  workerId    String?
  heartbeatAt DateTime?
  completionId String?   @unique
  modelRequestCount Int  @default(0)
  modelRequestLimit Int  @default(12)
  runtimeVersion Int      @default(1)
  eventSequence  Int      @default(0)
  coordinatorState Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  tasks  AgentTask[]
  events AgentRunEvent[]
  outbox AgentRunOutbox?
  artifactManifests AgentArtifactManifest[]
  coordinatorTurns AgentCoordinatorTurn[]
  taskCompletions AgentTaskCompletion[]
  runtimeOutbox AgentRuntimeOutbox[]

  @@index([spaceId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([workerId, heartbeatAt])
}

model AgentTask {
  id          String    @id @default(uuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentId     String
  agentName   String
  title       String
  instruction String
  acceptanceCriteria String?
  origin      String    @default("legacy_plan")
  parentTaskId String?
  mode        String     @default("executor")
  dependsOn   Json?
  skillId     String     @default("general-task")
  skillVersion String    @default("1.0.0")
  skillSnapshot Json?
  webResearchRequired Boolean @default(false)
  modelRequestCount Int  @default(0)
  modelRequestLimit Int  @default(8)
  status      String    @default("PENDING")
  result      String?
  error       String?
  reviewFeedback String?
  waitQuestion String?
  waitReason   String?
  waitAnswer   String?
  waitingAt    DateTime?
  proposedAt   DateTime?
  approvedAt   DateTime?
  submittedAt  DateTime?
  reviewDecision String?
  reviewSummary  String?
  attempt     Int       @default(1)
  sortOrder   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?

  artifactManifests AgentArtifactManifest[]
  completions AgentTaskCompletion[]

  @@index([runId, sortOrder])
  @@index([status])
}

model AgentCoordinatorTurn {
  id             String   @id @default(uuid())
  runId          String
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  triggerEventId String
  status         String   @default("QUEUED")
  inputSnapshot  Json?
  action         Json?
  error          String?
  modelRequestCount Int   @default(0)
  claimedBy      String?
  claimedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([runId, triggerEventId])
  @@index([status, createdAt])
  @@index([claimedBy, claimedAt])
}

model AgentTaskCompletion {
  id             String    @id @default(uuid())
  runId          String
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId         String
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt        Int
  workerId       String
  status         String
  report         String
  evidence       Json?
  artifacts      Json?
  validation     Json?
  idempotencyKey String    @unique
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([taskId, attempt])
  @@index([runId, createdAt])
  @@index([taskId, active])
}

model AgentArtifactManifest {
  id          String    @id @default(uuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId      String
  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt     Int
  status      String    @default("BASELINED")
  baseline    Json
  entries     Json?
  validation  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@unique([taskId, attempt])
  @@index([runId, createdAt])
}

model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type      String
  message   String
  payload   Json?
  idempotencyKey String? @unique
  sequence  Int      @default(0)
  taskId    String?
  agentId   String?
  attempt   Int?
  actor     String?
  createdAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([runId, taskId, sequence])
}

model AgentRunOutbox {
  id             String   @id @default(uuid())
  runId          String   @unique
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  idempotencyKey String   @unique
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  availableAt    DateTime @default(now())
  claimedBy      String?
  claimedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, availableAt])
  @@index([claimedBy, claimedAt])
}

model AgentRuntimeOutbox {
  id             String   @id @default(uuid())
  runId          String
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind           String
  aggregateId    String
  idempotencyKey String   @unique
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  availableAt    DateTime @default(now())
  claimedBy      String?
  claimedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, availableAt])
  @@index([runId, kind, createdAt])
  @@index([claimedBy, claimedAt])
}
